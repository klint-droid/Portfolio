# Firebase Configuration for Birthday Celebration Hub
# Replace with your actual Firebase project credentials from console.firebase.google.com
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Sheets Recommendations Integration
# Published CSV link for fetching recommendations
VITE_RECOMMENDATIONS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQ4OlW_kTFMThEUAIV2oeJXkbOPjtXgbqfYG-Bc4ESwoBnWCnoli1xm8Za5SQEP6g5M9b6_Jds3nOe6/pub?output=csv
# Google Apps Script Web App URL for submitting new recommendations (POST)
VITE_RECOMMENDATIONS_POST_URL=

